{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dolphin DAP (attach to port)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/dolphin-emu-nogui",
      "args": [
        "-C", "Main.General.DAPPort=5678",
        "--exec", "${input:gamePath}",
        "--platform", "headless"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerServerAddress": "localhost:5678",
      "stopAtEntry": false,
      "comment": "Phase 0 scaffold: starts Dolphin with DAPPort=5678. Replace with a DAP-aware client once the full adapter is wired; this documents the runtime invocation."
    }
  ],
  "inputs": [
    {
      "id": "gamePath",
      "type": "promptString",
      "description": "Path to GameCube/Wii ISO or ELF"
    }
  ]
}
